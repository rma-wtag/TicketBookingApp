@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TicketBooking</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Always visible: Home -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="fa-solid fa-house fa-lg me-2"></i> Home
            </NavLink>
        </div>

        <!-- Counter: Visible to all authenticated users -->
        @* <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="counter">
                        <i class="fa-solid fa-plus-square fa-lg me-2"></i> Counter
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView> *@

        <!-- Movies & Shows: Visible only to Users (role: User) -->
        <AuthorizeView Roles="User">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/user/notifications">
                    <i class="fa-solid fa-comments fa-lg me-2"></i> Notifications
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="movies">
                    <i class="fa-solid fa-film fa-lg me-2"></i> Movies
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="shows">
                    <i class="fa-solid fa-tv fa-lg me-2"></i> Shows
                </NavLink>
            </div>
        </AuthorizeView>

        <!-- Admin Movies & Shows: Visible only to Admin (role: Admin) -->
        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/movies">
                    <i class="fa-solid fa-play fa-lg me-2"></i> Admin Movies
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/shows">
                    <i class="fa-solid fa-calendar-days fa-lg me-2"></i> Admin Shows
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/payments">
                    <i class="fa-solid fa-money-check-dollar fa-lg me-2"></i> Payments
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
