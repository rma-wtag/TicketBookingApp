@page "/show/{ShowId:int}/book"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorApp.Services
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (show != null)
    {
        <div class="row">
            <!-- Back Button -->
            <div class="col-12 mb-3">
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Shows
                </button>
            </div>

            <!-- Show Details Card -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-film me-2"></i>
                            Show Details
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Poster -->
                            <div class="col-md-4 mb-3">
                                @if (!string.IsNullOrEmpty(show.Movie?.PosterUrl))
                                {
                                    <img src="@show.Movie.PosterUrl"
                                         alt="@show.Movie.Title poster"
                                         class="img-fluid rounded shadow"
                                         style="width: 100%; max-width: 300px; object-fit: cover;"
                                         onerror="this.src='https://via.placeholder.com/300x450/6c757d/ffffff?text=No+Image'">
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted"
                                         style="width: 100%; height: 300px; font-size: 16px;">
                                        <span>No Image Available</span>
                                    </div>
                                }
                            </div>

                            <!-- Movie Info -->
                            <div class="col-md-8">
                                <h3 class="fw-bold text-primary mb-3">@show.Movie?.Title</h3>

                                @if (!string.IsNullOrEmpty(show.Movie?.Description))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-muted">Description</h6>
                                        <p class="text-secondary">@show.Movie.Description</p>
                                    </div>
                                }

                                <div class="row mb-3">
                                    @if (show.Movie?.Rating > 0)
                                    {
                                        <div class="col-sm-6 mb-2">
                                            <strong>Rating:</strong>
                                            <span class="badge bg-warning text-dark ms-2">⭐ @show.Movie.Rating</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(show.Movie?.Duration))
                                    {
                                        <div class="col-sm-6 mb-2">
                                            <strong>Duration:</strong>
                                            <span class="text-muted ms-2">@show.Movie.Duration</span>
                                        </div>
                                    }
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-6 mb-2">
                                        <strong>Hall:</strong>
                                        <span class="badge bg-secondary ms-2">Hall @show.HallId</span>
                                        @if (!string.IsNullOrEmpty(show.Hall?.Name))
                                        {
                                            <div class="text-muted small">@show.Hall.Name</div>
                                        }
                                    </div>
                                    <div class="col-sm-6 mb-2">
                                        <strong>Price per ticket:</strong>
                                        <span class="text-success fw-bold ms-2 fs-5">${@show.Price}</span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6 mb-2">
                                        <strong>Start Time:</strong>
                                        <div class="text-muted">
                                            @show.StartTime.ToString("dddd, MMM dd, yyyy")
                                            <br>
                                            <span class="fw-medium">@show.StartTime.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 mb-2">
                                        <strong>End Time:</strong>
                                        <div class="text-muted">
                                            @show.EndTime.ToString("dddd, MMM dd, yyyy")
                                            <br>
                                            <span class="fw-medium">@show.EndTime.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Seat Selection Card -->
                <div class="card shadow-sm mt-4 mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-grid-3x3 me-2"></i>
                            Select Your Seats
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (isLoadingSeats)
                        {
                            <div class="text-center">
                                <div class="spinner-border text-info" role="status">
                                    <span class="visually-hidden">Loading seats...</span>
                                </div>
                                <p class="text-muted mt-2">Loading available seats...</p>
                            </div>
                        }
                        else if (availableSeats?.Any() == true)
                        {
                            <!-- Screen -->
                            <div class="text-center mb-4">
                                <div class="bg-dark text-white py-2 px-4 rounded-pill d-inline-block">
                                    <i class="bi bi-camera-reels me-2"></i>
                                    SCREEN
                                </div>
                            </div>

                            <!-- Legend -->
                            <div class="d-flex justify-content-center gap-4 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="seat-legend available me-2"></div>
                                    <small>Available</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="seat-legend selected me-2"></div>
                                    <small>Selected</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="seat-legend occupied me-2"></div>
                                    <small>Occupied</small>
                                </div>
                            </div>

                            <!-- Seat Grid -->
                            <div class="seat-grid">
                                @for (int row = 0; row < 8; row++)
                                {
                                    <div class="seat-row d-flex justify-content-center mb-2">
                                        <div class="row-label me-3 d-flex align-items-center">
                                            <strong>@((char)('A' + row))</strong>
                                        </div>
                                        @for (int col = 0; col < 5; col++)
                                        {
                                            int seatIndex = row * 5 + col;
                                            var seat = availableSeats[seatIndex];
                                            var isSelected = selectedSeatIds.Contains(seat.Id);
                                            var isOccupied = seat.BookingSeats?.Any() == true;

                                            <button class="seat-button @GetSeatClass(seat, isSelected, isOccupied)"
                                                    @onclick="() => ToggleSeat(seat)"
                                                    disabled="@isOccupied"
                                                    title="Seat @seat.SeatNumber">
                                                @seat.SeatNumber.Replace("S", "")
                                            </button>
                                        }
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-exclamation-circle fs-1"></i>
                                <p class="mt-2">No seats available for this show</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Booking Panel -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-ticket-perforated me-2"></i>
                            Book Tickets
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (selectedSeatIds.Any())
                        {
                            <!-- Selected Seats -->
                            <div class="mb-4">
                                <label class="form-label fw-medium">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Selected Seats
                                </label>
                                <div class="selected-seats-container">
                                    @foreach (var seatId in selectedSeatIds)
                                    {
                                        var seat = availableSeats?.FirstOrDefault(s => s.Id == seatId);
                                        if (seat != null)
                                        {
                                            <span class="badge bg-primary me-2 mb-2">
                                                @seat.SeatNumber
                                                <button type="button" class="btn-close btn-close-white ms-2" 
                                                        style="font-size: 0.65em;"
                                                        @onclick="() => RemoveSeat(seatId)"
                                                        title="Remove seat"></button>
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Price Summary -->
                            <div class="bg-light rounded p-3 mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Ticket Price:</span>
                                    <span>${@show.Price}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Selected Seats:</span>
                                    <span>@selectedSeatIds.Count</span>
                                </div>
                                <hr class="my-2">
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>Total:</span>
                                    <span class="text-success">${@(show.Price * selectedSeatIds.Count)}</span>
                                </div>
                            </div>

                            <!-- Book Button -->
                            <button class="btn btn-success w-100 btn-lg"
                                    @onclick="ConfirmBooking"
                                    disabled="@isBooking">
                                @if (isBooking)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-credit-card me-2"></i>
                                    <span>Confirm Booking (@selectedSeatIds.Count @(selectedSeatIds.Count == 1 ? "seat" : "seats"))</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-hand-index fs-1 mb-3"></i>
                                <p>Please select your seats from the seat map to proceed with booking.</p>
                            </div>
                        }

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1"></i>
                                Secure payment processing
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Bootstrap Notification Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header @GetModalHeaderClass()">
                    <h5 class="modal-title d-flex align-items-center">
                        <i class="@GetModalIconClass() me-2 fs-4"></i>
                        @modalTitle
                    </h5>
                    @if (!isRedirecting)
                    {
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    }
                </div>
                <div class="modal-body">
                    <p class="mb-0">@modalMessage</p>
                    @if (isRedirecting)
                    {
                        <div class="text-center mt-3">
                            <div class="spinner-border spinner-border-sm text-success" role="status">
                                <span class="visually-hidden">Redirecting...</span>
                            </div>
                        </div>
                    }
                </div>
                @if (!isRedirecting)
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Custom Styles -->
<style>
    .seat-grid {
        max-width: 400px;
        margin: 0 auto;
    }

    .seat-row {
        margin-bottom: 8px;
    }

    .row-label {
        width: 30px;
        font-size: 14px;
        color: #6c757d;
    }

    .seat-button {
        width: 35px;
        height: 35px;
        margin: 2px;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        background-color: #28a745;
        color: white;
        font-size: 11px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
