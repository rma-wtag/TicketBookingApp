        transform: scale(1.05);
    }

    .seat-button.occupied {
        background-color: #6c757d;
        border-color: #545b62;
        cursor: not-allowed;
        opacity: 0.6;
    }

    .seat-legend {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border: 2px solid #dee2e6;
    }

    .seat-legend.available {
        background-color: #28a745;
        border-color: #1e7e34;
    }

    .seat-legend.selected {
        background-color: #007bff;
