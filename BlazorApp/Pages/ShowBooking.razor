        max-height: 120px;
        overflow-y: auto;
    }

    .btn-close-white {
        filter: invert(1) grayscale(100%) brightness(200%);
    }
</style>

@code {
    [Parameter] public int ShowId { get; set; }

    private Show? show;
    private List<Seat>? availableSeats;
    private HashSet<int> selectedSeatIds = new();

    private bool isLoading = true;
    private bool isLoadingSeats = true;
    private bool isBooking = false;

    // Modal properties
    private bool showModal = false;
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalType = "info"; // info, success, warning, error
    private bool isRedirecting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadShow();
        await LoadAvailableSeats();
    }

    private async Task LoadShow()
    {
        try
        {
            isLoading = true;

            var response = await Http.GetAsync($"/api/v1/Show/{ShowId}");

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };
                show = JsonSerializer.Deserialize<Show>(jsonString, options);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                ShowModal("Show Not Found", "Show not found. It may have been cancelled or removed.", "error");
            }
            else
            {
                ShowModal("Loading Error", $"Failed to load show details. Status: {response.StatusCode}", "error");
            }
        }
        catch (Exception ex)
        {
            ShowModal("Connection Error", $"Error loading show details: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAvailableSeats()
    {
        try
        {
            isLoadingSeats = true;

            var response = await Http.GetAsync($"/api/v1/Booking/AvailableSeats/{ShowId}");

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };
                var fetchedSeats = JsonSerializer.Deserialize<List<Seat>>(jsonString, options) ?? new List<Seat>();

                // Create full 40 seats (S01 to S40)
                var fullSeats = new List<Seat>();

                for (int i = 1; i <= 40; i++)
                {
                    string seatNumber = $"S{i:D2}"; // S01, S02, ..., S40

                    // Try to find this seat in the API response
                    var seatFromApi = fetchedSeats.FirstOrDefault(s =>
                        s.SeatNumber.Equals(seatNumber, StringComparison.OrdinalIgnoreCase));

                    if (seatFromApi != null)
                    {
                        // Seat is available
                        fullSeats.Add(seatFromApi);
                    }
                    else
                    {
                        // Seat is occupied → placeholder with BookingSeats so it's shown as unavailable
                        fullSeats.Add(new Seat
                        {
                            Id = -i, // temporary negative ID to avoid collision
                            SeatNumber = seatNumber,
                            BookingSeats = new List<BookingSeat> { new BookingSeat() }
                        });
                    }
                }

                availableSeats = fullSeats;
            }
            else
            {
                ShowModal("Loading Error", $"Failed to load available seats. Status: {response.StatusCode}", "error");
                availableSeats = new List<Seat>();
            }
        }
        catch (Exception ex)
        {
            ShowModal("Connection Error", $"Error loading available seats: {ex.Message}", "error");
            availableSeats = new List<Seat>();
        }
        finally
        {
            isLoadingSeats = false;
        }
    }

    private void ToggleSeat(Seat? seat)
    {
        if (seat == null || (seat.BookingSeats?.Any() == true)) // occupied
            return;

        if (selectedSeatIds.Contains(seat.Id))
            selectedSeatIds.Remove(seat.Id);
        else
            selectedSeatIds.Add(seat.Id);

        StateHasChanged();
    }

    private Seat? GetSeatInfo(string seatCode)
    {
        return availableSeats?.FirstOrDefault(s => s.SeatNumber.Equals(seatCode, StringComparison.OrdinalIgnoreCase));
    }

    private void RemoveSeat(int seatId)
    {
        selectedSeatIds.Remove(seatId);
        StateHasChanged();
    }

    private string GetSeatClass(Seat? seat, bool isSelected, bool isOccupied)
    {
        if (isOccupied || seat == null)
            return "occupied";
        if (isSelected)
            return "selected";
        return "available";
    }

    private async Task ConfirmBooking()
    {
        if (!selectedSeatIds.Any())
        {
            ShowModal("No Seats Selected", "Please select at least one seat before proceeding with the booking.", "warning");
            return;
        }

        try
        {
            isBooking = true;

            // STEP 1: Verify seat availability again
            var availabilityResponse = await Http.GetAsync($"/api/v1/Booking/AvailableSeats/{ShowId}");
            if (!availabilityResponse.IsSuccessStatusCode)
            {
                ShowModal("Connection Error", "Failed to verify seat availability. Please check your connection and try again.", "error");
                return;
            }

            var availabilityJson = await availabilityResponse.Content.ReadAsStringAsync();
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var currentlyAvailableSeats = JsonSerializer.Deserialize<List<Seat>>(availabilityJson, options) ?? new List<Seat>();

            var currentlyAvailableSeatIds = currentlyAvailableSeats.Select(s => s.Id).ToHashSet();

            var unavailableSeats = selectedSeatIds.Where(id => !currentlyAvailableSeatIds.Contains(id)).ToList();
            if (unavailableSeats.Any())
            {
                // Get seat numbers for unavailable seats
                var unavailableSeatNumbers = unavailableSeats
                    .Select(unavailableSeatId => availableSeats?.FirstOrDefault(s => s.Id == unavailableSeatId)?.SeatNumber)
                    .Where(sn => sn != null)
                    .ToList()!;

                // Remove them from selection
                foreach (var id in unavailableSeats)
                    selectedSeatIds.Remove(id);

                var seatList = string.Join(", ", unavailableSeatNumbers);
                var seatWord = unavailableSeats.Count == 1 ? "seat" : "seats";
                var hasHave = unavailableSeats.Count == 1 ? "has" : "have";
                var isAre = unavailableSeats.Count == 1 ? "is" : "are";

                var modalMessage = $"Sorry, the following {seatWord} {seatList} {isAre} no longer available and {hasHave} been removed from your selection.";
                modalMessage += selectedSeatIds.Any()
                    ? " You can proceed with your remaining selection or choose different seats."
                    : " Please select new seats to continue.";

                ShowModal("Seats No Longer Available", modalMessage, "warning");

                await LoadAvailableSeats();
                StateHasChanged();
                return;
            }

            // STEP 2: Proceed with booking
            var bookingRequest = new BookingRequest
        {
            UserId = 1, // Replace with logged-in user
            ShowId = ShowId,
            SelectedSeatIds = selectedSeatIds.ToList()
        };

            var json = JsonSerializer.Serialize(bookingRequest);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var bookingResponse = await Http.PostAsync("/api/v1/Booking", content);

            if (!bookingResponse.IsSuccessStatusCode)
            {
                var errorContent = await bookingResponse.Content.ReadAsStringAsync();

                if (errorContent.ToLower().Contains("seat") &&
                    (errorContent.ToLower().Contains("unavailable") || errorContent.ToLower().Contains("occupied") || errorContent.ToLower().Contains("booked")))
                {
                    ShowModal("Booking Conflict", "One or more selected seats have been booked by another user. The seat map has been refreshed. Please select different seats.", "error");
                    await LoadAvailableSeats();
                    selectedSeatIds.Clear();
                }
                else
                {
                    ShowModal("Booking Failed", $"Unable to complete your booking: {errorContent}", "error");
                }
                return;
            }

            // STEP 3: Parse booking response to get payment info
            var bookingJson = await bookingResponse.Content.ReadAsStringAsync();
            var bookingResult = JsonSerializer.Deserialize<BookingResponse>(bookingJson, options);

            if (bookingResult?.Payment == null)
            {
                ShowModal("Payment Error", "Booking was created but payment information is missing.", "error");
                return;
            }

            // STEP 4: Create Payment Session
            var paymentSessionRequest = new PaymentSessionRequest
            {
                BookingId = bookingResult.Id,
                CusName = "Demo Customer",           // TODO: Replace with actual user name
                CusEmail = "demo@example.com",       // TODO: Replace with actual user email
                Amount = bookingResult.Payment.Amount
            };

            var paymentJson = JsonSerializer.Serialize(paymentSessionRequest);
            var paymentContent = new StringContent(paymentJson, System.Text.Encoding.UTF8, "application/json");

            var paymentResponse = await Http.PostAsync("/api/v1/Payment/session", paymentContent);

            if (!paymentResponse.IsSuccessStatusCode)
            {
                ShowModal("Payment Error", "Failed to initiate payment session. Please try again.", "error");
                return;
            }

            var paymentResponseJson = await paymentResponse.Content.ReadAsStringAsync();
            var paymentResult = JsonSerializer.Deserialize<PaymentSessionResponse>(paymentResponseJson, options);

            if (string.IsNullOrEmpty(paymentResult?.GatewayUrl))
            {
                ShowModal("Payment Error", "Invalid payment gateway response.", "error");
                return;
            }

            // STEP 5: Redirect user to payment gateway
            Navigation.NavigateTo(paymentResult.GatewayUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            ShowModal("Unexpected Error", $"An error occurred while processing your booking: {ex.Message}", "error");
        }
        finally
        {
            isBooking = false;
            StateHasChanged();
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/shows");
    }

    // Modal methods
    private void ShowModal(string title, string message, string type = "info", bool redirecting = false)
    {
        modalTitle = title;
        modalMessage = message;
        modalType = type;
        isRedirecting = redirecting;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private string GetModalIconClass()
    {
        return modalType switch
        {
            "success" => "bi-check-circle-fill text-success",
            "warning" => "bi-exclamation-triangle-fill text-warning",
            "error" => "bi-x-circle-fill text-danger",
            _ => "bi-info-circle-fill text-info"
        };
    }

    private string GetModalHeaderClass()
    {
        return modalType switch
        {
            "success" => "bg-success text-white",
            "warning" => "bg-warning text-dark",
            "error" => "bg-danger text-white",
            _ => "bg-info text-white"
        };
    }

    // Data models
    public class Show
    {
        public int Id { get; set; }
        public int MovieId { get; set; }
        public Movie? Movie { get; set; }
        public int HallId { get; set; }
        public Hall? Hall { get; set; }
        public decimal Price { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
    }

    public class Movie
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public double Rating { get; set; }
        public string Duration { get; set; } = "";
        public string PosterUrl { get; set; } = "";
    }

    public class Hall
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class Seat
    {
        public int Id { get; set; }
        public string SeatNumber { get; set; } = "";
        public int HallId { get; set; }
        public Hall? Hall { get; set; }
        public List<BookingSeat>? BookingSeats { get; set; }
    }

    public class BookingSeat
    {
        public int Id { get; set; }
        public int BookingId { get; set; }
        public int SeatId { get; set; }
    }

    public class BookingRequest
    {
        public int UserId { get; set; }
        public int ShowId { get; set; }
