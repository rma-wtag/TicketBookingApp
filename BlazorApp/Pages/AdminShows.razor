@page "/admin/shows"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Shows Management</h1>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-primary me-2" @onclick="ShowUploadModal">
                <i class="fas fa-upload"></i> Upload CSV
            </button>
        </div>
        <div>
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="fas fa-plus"></i> Add Show
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0">ID</th>
                                <th class="border-0">Movie</th>
                                <th class="border-0">Hall</th>
                                <th class="border-0">Price</th>
                                <th class="border-0">Start Time</th>
                                <th class="border-0">End Time</th>
                                <th class="border-0">Duration</th>
                                <th class="border-0 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (shows.Any())
                            {
                                @foreach (var show in shows)
                                {
                                    <tr class="@GetRowClass(show.StartTime)">
                                        <td class="align-middle">@show.Id</td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(show.Movie?.PosterUrl))
                                                {
                                                    <img src="@show.Movie.PosterUrl" alt="@show.Movie.Title" class="rounded me-2" style="width: 30px; height: 45px; object-fit: cover;" />
                                                }
                                                <div>
                                                    <div class="fw-semibold">@(show.Movie?.Title ?? $"Movie ID: {show.MovieId}")</div>
                                                    @if (show.Movie?.Rating > 0)
                                                    {
                                                        <small class="text-muted">★ @show.Movie.Rating.ToString("F1")</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <div class="fw-semibold">@(show.Hall?.Name ?? $"Hall {show.HallId}")</div>
                                            @if (show.Hall != null)
                                            {
                                                <small class="text-muted">Capacity: @show.Hall.Capacity</small>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge bg-success rounded-pill">$@show.Price.ToString("F2")</span>
                                        </td>
                                        <td class="align-middle">
                                            <div>@show.StartTime.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@show.StartTime.ToString("hh:mm tt")</small>
                                        </td>
                                        <td class="align-middle">
                                            <div>@show.EndTime.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@show.EndTime.ToString("hh:mm tt")</small>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge bg-info rounded-pill">
                                                @FormatDuration(show.EndTime - show.StartTime)
                                            </span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(show)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteConfirmation(show)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fas fa-calendar-alt fa-2x mb-3 d-block"></i>
                                        No shows found. Add your first show to get started.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create/Edit Show Modal -->
<div class="modal fade @(showShowModal ? "show d-block" : "")" tabindex="-1" style="@(showShowModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">@(isEditing ? "Edit Show" : "Add New Show")</h5>
                <button type="button" class="btn-close" @onclick="CloseShowModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="showForm" OnValidSubmit="SaveShow">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Movie <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="showForm.MovieId" class="form-select">
                                <option value="0">Select a movie</option>
                                @foreach (var movie in availableMovies)
                                {
                                    <option value="@movie.Id">@movie.Title</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => showForm.MovieId" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Hall <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="showForm.HallId" class="form-select">
                                <option value="0">Select a hall</option>
                                @foreach (var hall in availableHalls)
                                {
                                    <option value="@hall.Id">@hall.Name (Capacity: @hall.Capacity)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => showForm.HallId" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="showForm.Price" class="form-control" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <ValidationMessage For="() => showForm.Price" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Start Date & Time <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="startDate" class="form-control" />
                            <InputText @bind-Value="startTime" class="form-control mt-2" placeholder="HH:MM" />
                            <div class="form-text">Time format: HH:MM (24-hour)</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">End Date & Time <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="endDate" class="form-control" />
                            <InputText @bind-Value="endTime" class="form-control mt-2" placeholder="HH:MM" />
                            <div class="form-text">Time format: HH:MM (24-hour)</div>
                        </div>

                        @if (selectedMovie != null)
                        {
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(selectedMovie.PosterUrl))
                                        {
                                            <img src="@selectedMovie.PosterUrl" alt="@selectedMovie.Title" class="rounded me-3" style="width: 40px; height: 60px; object-fit: cover;" />
                                        }
                                        <div>
                                            <h6 class="mb-1">@selectedMovie.Title</h6>
                                            <small class="text-muted">Duration: @FormatDuration(selectedMovie.Duration) | Rating: @selectedMovie.Rating.ToString("F1")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseShowModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(isEditing ? "Update Show" : "Create Show")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- CSV Upload Modal -->
<div class="modal fade @(showUploadModal ? "show d-block" : "")" tabindex="-1" style="@(showUploadModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Upload Shows CSV</h5>
                <button type="button" class="btn-close" @onclick="CloseUploadModal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">CSV File</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".csv" />
                    <div class="form-text">
                        Upload a CSV file with show data. Expected columns: MovieId, HallId, Price, StartTime, EndTime
                    </div>
                </div>

                @if (selectedFile != null)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-file-csv"></i> Selected: @selectedFile.Name (@FormatBytes(selectedFile.Size))
                    </div>
                }

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseUploadModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(selectedFile == null || uploading)">
                        @if (uploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Upload
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" tabindex="-1" style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
            </div>
            <div class="modal-body">
                @if (showToDelete != null)
                {
                    <p>Are you sure you want to delete this show?</p>
                    <div class="alert alert-warning">
                        <strong>Movie:</strong> @(showToDelete.Movie?.Title ?? $"Movie ID: {showToDelete.MovieId}")<br>
                        <strong>Hall:</strong> @(showToDelete.Hall?.Name ?? $"Hall {showToDelete.HallId}")<br>
                        <strong>Time:</strong> @showToDelete.StartTime.ToString("MMM dd, yyyy hh:mm tt")
                    </div>
                    <p class="text-muted small">This action cannot be undone.</p>
                }

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteShow" disabled="@deleting">
                        @if (deleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete Show
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Show> shows = new();
    private List<Movie> availableMovies = new();
    private List<Hall> availableHalls = new();
    private bool loading = true;
    private bool saving = false;
    private bool deleting = false;
    private bool uploading = false;

    private bool showShowModal = false;
    private bool showUploadModal = false;
    private bool showDeleteModal = false;
    private bool isEditing = false;

    private ShowForm showForm = new();
    private DateOnly startDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.Today);
    private string startTime = "09:00";
    private string endTime = "11:00";

    private Show? showToDelete;
    private IBrowserFile? selectedFile;
    private Movie? selectedMovie => availableMovies.FirstOrDefault(m => m.Id == showForm.MovieId);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadShows(), LoadMovies(), LoadHalls());
    }

    private async Task LoadShows()
    {
        try
        {
            loading = true;
            var response = await Http.GetAsync("api/v1/Show/GetAll");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                shows = JsonSerializer.Deserialize<List<Show>>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Show>();

                // Sort by start time (most recent first)
                shows = shows.OrderByDescending(s => s.StartTime).ToList();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading shows: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadMovies()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/Movie/GetAll");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                availableMovies = JsonSerializer.Deserialize<List<Movie>>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Movie>();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading movies: {ex.Message}");
        }
    }

    private async Task LoadHalls()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/Hall/GetAll");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                availableHalls = JsonSerializer.Deserialize<List<Hall>>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Hall>();
            }
        }
        catch (Exception ex)
        {
            // If halls endpoint doesn't exist, create dummy halls for demo
            availableHalls = new List<Hall>
            {
                new Hall { Id = 1, Name = "Hall A", Capacity = 100 },
                new Hall { Id = 2, Name = "Hall B", Capacity = 150 },
                new Hall { Id = 3, Name = "Hall C", Capacity = 200 }
            };
        }
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        showForm = new ShowForm();
        startDate = DateOnly.FromDateTime(DateTime.Today);
        endDate = DateOnly.FromDateTime(DateTime.Today);
        startTime = "09:00";
        endTime = "11:00";
        showShowModal = true;
    }

    private void ShowEditModal(Show show)
    {
        isEditing = true;
        showForm = new ShowForm
        {
            Id = show.Id,
            MovieId = show.MovieId,
            HallId = show.HallId,
            Price = show.Price,
            StartTime = show.StartTime,
            EndTime = show.EndTime
        };

        startDate = DateOnly.FromDateTime(show.StartTime);
        endDate = DateOnly.FromDateTime(show.EndTime);
        startTime = show.StartTime.ToString("HH:mm");
        endTime = show.EndTime.ToString("HH:mm");

        showShowModal = true;
    }

    private void CloseShowModal()
    {
        showShowModal = false;
        showForm = new ShowForm();
    }

    private async Task SaveShow()
    {
        try
        {
            saving = true;

            // Parse date and time
            if (TimeOnly.TryParse(startTime, out var startTimeOnly) &&
                TimeOnly.TryParse(endTime, out var endTimeOnly))
            {
                showForm.StartTime = startDate.ToDateTime(startTimeOnly);
                showForm.EndTime = endDate.ToDateTime(endTimeOnly);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Invalid time format. Please use HH:MM format.");
                return;
            }

            // Validation
            if (showForm.EndTime <= showForm.StartTime)
            {
                await JSRuntime.InvokeVoidAsync("alert", "End time must be after start time.");
                return;
            }

            HttpResponseMessage response;

            if (isEditing)
            {
                var updateData = new
                {
                    MovieId = showForm.MovieId,
                    HallId = showForm.HallId,
                    Price = showForm.Price,
                    StartTime = showForm.StartTime,
                    EndTime = showForm.EndTime
                };
                response = await Http.PutAsJsonAsync($"api/v1/Show/{showForm.Id}", updateData);
            }
            else
            {
                var createData = new
                {
                    MovieId = showForm.MovieId,
                    HallId = showForm.HallId,
                    Price = showForm.Price,
                    StartTime = showForm.StartTime,
                    EndTime = showForm.EndTime
                };
                response = await Http.PostAsJsonAsync("api/v1/Show", createData);
            }

            if (response.IsSuccessStatusCode)
            {
                CloseShowModal();
                await LoadShows();
                await JSRuntime.InvokeVoidAsync("alert", $"Show {(isEditing ? "updated" : "created")} successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving show: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowDeleteConfirmation(Show show)
    {
        showToDelete = show;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        showToDelete = null;
    }

    private async Task DeleteShow()
    {
        if (showToDelete == null) return;

        try
        {
            deleting = true;
            var response = await Http.DeleteAsync($"api/v1/Show/{showToDelete.Id}");

            if (response.IsSuccessStatusCode)
            {
                CloseDeleteModal();
                await LoadShows();
                await JSRuntime.InvokeVoidAsync("alert", "Show deleted successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting show: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting show: {ex.Message}");
        }
        finally
        {
            deleting = false;
        }
    }

    private void ShowUploadModal()
    {
        selectedFile = null;
        showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        try
        {
            uploading = true;

            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(selectedFile.OpenReadStream());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "file", selectedFile.Name);

            var response = await Http.PostAsync("api/v1/Show/upload", content);

            if (response.IsSuccessStatusCode)
            {
                CloseUploadModal();
                await LoadShows();
                await JSRuntime.InvokeVoidAsync("alert", "Shows uploaded successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error uploading file: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error uploading file: {ex.Message}");
        }
        finally
        {
            uploading = false;
        }
    }

    private string GetRowClass(DateTime startTime)
    {
        var now = DateTime.Now;
        if (startTime < now)
            return "table-secondary"; // Past shows
        else if (startTime <= now.AddDays(1))
            return "table-warning"; // Shows within 24 hours
        else
            return ""; // Future shows
    }

    private string FormatDuration(TimeSpan duration)
    {
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }

    private string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }

    public class Show
    {
        public int Id { get; set; }
        public int MovieId { get; set; }
        public Movie? Movie { get; set; }
        public int HallId { get; set; }
        public Hall? Hall { get; set; }
        public decimal Price { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
    }

    public class Movie
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public decimal Rating { get; set; }
        public TimeSpan Duration { get; set; }
        public string? PosterUrl { get; set; }
    }

    public class Hall
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int Capacity { get; set; }
    }

    public class ShowForm
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "MovieId is required.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a movie.")]
        public int MovieId { get; set; }

        [Required(ErrorMessage = "HallId is required.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a hall.")]
        public int HallId { get; set; }

        [Required(ErrorMessage = "Price is required.")]
        [Range(0, double.MaxValue, ErrorMessage = "Price must be greater than or equal to 0.")]
        public decimal Price { get; set; }

        public DateTime StartTime { get; set; } = DateTime.Now;
        public DateTime EndTime { get; set; } = DateTime.Now;
    }
}