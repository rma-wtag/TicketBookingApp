@page "/admin/movies"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Movies Management</h1>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-primary me-2" @onclick="ShowUploadModal">
                <i class="fas fa-upload"></i> Upload CSV
            </button>
        </div>
        <div>
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="fas fa-plus"></i> Add Movie
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0">Poster</th>
                        <th class="border-0">Title</th>
                        <th class="border-0">Description</th>
                        <th class="border-0">Rating</th>
                        <th class="border-0">Duration</th>
                        <th class="border-0 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (movies.Any())
                    {
                        @foreach (var movie in movies)
                        {
                            <tr>
                                <td class="align-middle">@movie.Id</td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                        {
                                            <img src="@movie.PosterUrl" alt="@movie.Title" class="rounded me-2" style="width: 40px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 60px;">
                                                <i class="fas fa-film text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="fw-semibold">@movie.Title</div>
                                </td>
                                <td class="align-middle">
                                    <div style="max-width: 300px;" class="text-truncate">
                                        @(string.IsNullOrEmpty(movie.Description) ? "No description" : movie.Description)
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (movie.Rating > 0)
                                    {
                                        <span class="badge bg-success rounded-pill">★ @movie.Rating.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No rating</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-info rounded-pill">@FormatDuration(movie.Duration)</span>
                                </td>
                                <td class="align-middle text-center">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(movie)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteConfirmation(movie)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-film fa-2x mb-3 d-block"></i>
                                No movies found. Add your first movie to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
    }
</div>

<!-- Create/Edit Movie Modal -->
<div class="modal fade @(showMovieModal ? "show d-block" : "")" tabindex="-1" style="@(showMovieModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">@(isEditing ? "Edit Movie" : "Add New Movie")</h5>
                <button type="button" class="btn-close" @onclick="CloseMovieModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="movieForm" OnValidSubmit="SaveMovie">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText @bind-Value="movieForm.Title" class="form-control" placeholder="Enter movie title" />
                            <ValidationMessage For="() => movieForm.Title" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Duration <span class="text-danger">*</span></label>
                            <InputText @bind-Value="durationString" class="form-control" placeholder="e.g., 02:30:00" />
                            <ValidationMessage For="() => movieForm.Duration" class="text-danger small mt-1" />
                            <div class="form-text">Format: HH:MM:SS</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Rating</label>
                            <InputNumber @bind-Value="movieForm.Rating" class="form-control" step="0.1" min="0" max="10" />
                            <ValidationMessage For="() => movieForm.Rating" class="text-danger small mt-1" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Poster URL</label>
                            <InputText @bind-Value="movieForm.PosterUrl" class="form-control" placeholder="https://example.com/poster.jpg" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="movieForm.Description" class="form-control" rows="4" placeholder="Enter movie description" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseMovieModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(isEditing ? "Update Movie" : "Create Movie")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- CSV Upload Modal -->
<div class="modal fade @(showUploadModal ? "show d-block" : "")" tabindex="-1" style="@(showUploadModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Upload Movies CSV</h5>
                <button type="button" class="btn-close" @onclick="CloseUploadModal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">CSV File</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".csv" />
                    <div class="form-text">
                        Upload a CSV file with movie data. Expected columns: Title, Description, Rating, Duration, PosterUrl
                    </div>
                </div>

                @if (selectedFile != null)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-file-csv"></i> Selected: @selectedFile.Name (@FormatBytes(selectedFile.Size))
                    </div>
                }

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseUploadModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(selectedFile == null || uploading)">
                        @if (uploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Upload
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" tabindex="-1" style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@movieToDelete?.Title</strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteMovie" disabled="@deleting">
                        @if (deleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete Movie
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Movie> movies = new();
    private bool loading = true;
    private bool saving = false;
    private bool deleting = false;
    private bool uploading = false;

    private bool showMovieModal = false;
    private bool showUploadModal = false;
    private bool showDeleteModal = false;
    private bool isEditing = false;

    private MovieForm movieForm = new();
    private string durationString = "";
    private Movie? movieToDelete;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadMovies();
    }

    private async Task LoadMovies()
    {
        try
        {
            loading = true;
            var response = await Http.GetAsync("api/v1/Movie/GetAll");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                movies = JsonSerializer.Deserialize<List<Movie>>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Movie>();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading movies: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        movieForm = new MovieForm();
        durationString = "";
        showMovieModal = true;
    }

    private void ShowEditModal(Movie movie)
    {
        isEditing = true;
        movieForm = new MovieForm
        {
            Id = movie.Id,
            Title = movie.Title,
            Description = movie.Description,
            Rating = movie.Rating,
            Duration = movie.Duration,
            PosterUrl = movie.PosterUrl
        };
        durationString = movie.Duration.ToString(@"hh\:mm\:ss");
        showMovieModal = true;
    }

    private void CloseMovieModal()
    {
        showMovieModal = false;
        movieForm = new MovieForm();
        durationString = "";
    }

    private async Task SaveMovie()
    {
        try
        {
            saving = true;

            // Parse duration
            if (TimeSpan.TryParse(durationString, out var duration))
            {
                movieForm.Duration = duration;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Invalid duration format. Please use HH:MM:SS format.");
                return;
            }

            HttpResponseMessage response;

            if (isEditing)
            {
                var updateData = new
                {
                    Description = movieForm.Description,
                    Rating = movieForm.Rating,
                    Duration = movieForm.Duration.ToString()
                };
                response = await Http.PutAsJsonAsync($"api/v1/Movie/{movieForm.Id}", updateData);
            }
            else
            {
                var createData = new
                {
                    Title = movieForm.Title,
                    Description = movieForm.Description,
                    Rating = movieForm.Rating,
                    Duration = movieForm.Duration.ToString(),
                    PosterUrl = movieForm.PosterUrl
                };
                response = await Http.PostAsJsonAsync("api/v1/Movie", createData);
            }

            if (response.IsSuccessStatusCode)
            {
                CloseMovieModal();
                await LoadMovies();
                await JSRuntime.InvokeVoidAsync("alert", $"Movie {(isEditing ? "updated" : "created")} successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving movie: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowDeleteConfirmation(Movie movie)
    {
        movieToDelete = movie;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        movieToDelete = null;
    }

    private async Task DeleteMovie()
    {
        if (movieToDelete == null) return;

        try
        {
            deleting = true;
            var response = await Http.DeleteAsync($"api/v1/Movie/{movieToDelete.Id}");

            if (response.IsSuccessStatusCode)
            {
                CloseDeleteModal();
                await LoadMovies();
                await JSRuntime.InvokeVoidAsync("alert", "Movie deleted successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting movie: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting movie: {ex.Message}");
        }
        finally
        {
            deleting = false;
        }
    }

    private void ShowUploadModal()
    {
        selectedFile = null;
        showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        try
        {
            uploading = true;

            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(selectedFile.OpenReadStream());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "file", selectedFile.Name);

            var response = await Http.PostAsync("api/v1/Movie/upload", content);

            if (response.IsSuccessStatusCode)
            {
                CloseUploadModal();
                await LoadMovies();
                await JSRuntime.InvokeVoidAsync("alert", "Movies uploaded successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error uploading file: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error uploading file: {ex.Message}");
        }
        finally
        {
            uploading = false;
        }
    }

    private string GetRatingBadgeColor(decimal rating)
    {
        return rating switch
        {
            >= 8 => "success",
            >= 6 => "warning",
            _ => "danger"
        };
    }

    private string FormatDuration(TimeSpan duration)
    {
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }

    private string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }

    public class Movie
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public decimal Rating { get; set; }
        public TimeSpan Duration { get; set; }
        public string? PosterUrl { get; set; }
    }

    public class MovieForm
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Movie Title is required.")]
        public string Title { get; set; } = "";

        public string? Description { get; set; }

        [Range(0, 10.0, ErrorMessage = "Rating should be between 0 to 10.")]
        public decimal Rating { get; set; }

        [Required(ErrorMessage = "Movie duration is required.")]
        public TimeSpan Duration { get; set; }

        public string? PosterUrl { get; set; }
    }
}